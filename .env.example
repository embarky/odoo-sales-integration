# Optional. Without a .env file, docker compose runs the API against the local demo Odoo.
# To use another Odoo instance, copy this file to .env and fill in the real values.
# Never commit .env.

# Odoo instance used by the API
ODOO_URL=https://mycompany.odoo.com
ODOO_DB=mycompany
ODOO_USER=api.user@example.com
ODOO_PASSWORD=change-me

# Keep true for odoo.com. Set to false only for a test server with a self-signed certificate.
ODOO_VERIFY_SSL=true
# Seconds before a call to Odoo is abandoned
ODOO_TIMEOUT=30

# Time zone used to display and enter delivery dates
APP_TIMEZONE=Europe/Zurich

# Comma-separated list of origins allowed to call the API from a browser
CORS_ORIGINS=*
