<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Saturne" targetNamespace="http://heclausanne-saturne/bpmn">
  <bpmn:collaboration id="Collab">
    <bpmn:participant id="P_Customer" name="Customer" processRef="Proc_Customer"/>
    <bpmn:participant id="P_Company" name="Saturne Furniture (Odoo ERP)" processRef="Proc_Company"/>
    <bpmn:messageFlow id="M_C_sendReq_S_start" name="Request" sourceRef="C_sendReq" targetRef="S_start"/>
    <bpmn:messageFlow id="M_S_sendQ_C_reviewQ" name="Quotation" sourceRef="S_sendQ" targetRef="C_reviewQ"/>
    <bpmn:messageFlow id="M_C_sign_S_accept" name="Signed quotation" sourceRef="C_sign" targetRef="S_accept"/>
    <bpmn:messageFlow id="M_C_refuse_S_refuse" name="Refusal" sourceRef="C_refuse" targetRef="S_refuse"/>
    <bpmn:messageFlow id="M_W_validate_C_goods" name="Goods + delivery slip" sourceRef="W_validate" targetRef="C_goods"/>
    <bpmn:messageFlow id="M_A_send_C_inv" name="Invoice" sourceRef="A_send" targetRef="C_inv"/>
    <bpmn:messageFlow id="M_C_pay_A_wait" name="Payment" sourceRef="C_pay" targetRef="A_wait"/>
    <bpmn:messageFlow id="M_W_notify_P_Customer" name="Delay notice" sourceRef="W_notify" targetRef="P_Customer"/>
    <bpmn:messageFlow id="M_A_remind_P_Customer" name="Reminder" sourceRef="A_remind" targetRef="P_Customer"/>
  </bpmn:collaboration>
  <bpmn:process id="Proc_Customer" isExecutable="false">
    <bpmn:startEvent id="C_start" name="Need for products"><bpmn:outgoing>F_C_start_C_sendReq</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sendTask id="C_sendReq" name="Send request for quotation"><bpmn:incoming>F_C_start_C_sendReq</bpmn:incoming><bpmn:outgoing>F_C_sendReq_C_reviewQ</bpmn:outgoing></bpmn:sendTask>
    <bpmn:receiveTask id="C_reviewQ" name="Receive &amp; review quotation"><bpmn:incoming>F_C_sendReq_C_reviewQ</bpmn:incoming><bpmn:outgoing>F_C_reviewQ_C_gw</bpmn:outgoing></bpmn:receiveTask>
    <bpmn:exclusiveGateway id="C_gw" name="Accept quotation?"><bpmn:incoming>F_C_reviewQ_C_gw</bpmn:incoming><bpmn:outgoing>F_C_gw_C_sign</bpmn:outgoing><bpmn:outgoing>F_C_gw_C_refuse</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="C_sign" name="Sign &amp; accept quotation online"><bpmn:incoming>F_C_gw_C_sign</bpmn:incoming><bpmn:outgoing>F_C_sign_C_goods</bpmn:outgoing></bpmn:sendTask>
    <bpmn:sendTask id="C_refuse" name="Send refusal"><bpmn:incoming>F_C_gw_C_refuse</bpmn:incoming><bpmn:outgoing>F_C_refuse_C_endCancel</bpmn:outgoing></bpmn:sendTask>
    <bpmn:endEvent id="C_endCancel" name="Purchase abandoned"><bpmn:incoming>F_C_refuse_C_endCancel</bpmn:incoming></bpmn:endEvent>
    <bpmn:receiveTask id="C_goods" name="Receive / collect goods"><bpmn:incoming>F_C_sign_C_goods</bpmn:incoming><bpmn:outgoing>F_C_goods_C_inv</bpmn:outgoing></bpmn:receiveTask>
    <bpmn:receiveTask id="C_inv" name="Receive invoice"><bpmn:incoming>F_C_goods_C_inv</bpmn:incoming><bpmn:outgoing>F_C_inv_C_pay</bpmn:outgoing></bpmn:receiveTask>
    <bpmn:sendTask id="C_pay" name="Pay invoice"><bpmn:incoming>F_C_inv_C_pay</bpmn:incoming><bpmn:outgoing>F_C_pay_C_end</bpmn:outgoing></bpmn:sendTask>
    <bpmn:endEvent id="C_end" name="Purchase completed"><bpmn:incoming>F_C_pay_C_end</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F_C_start_C_sendReq" sourceRef="C_start" targetRef="C_sendReq"/>
    <bpmn:sequenceFlow id="F_C_sendReq_C_reviewQ" sourceRef="C_sendReq" targetRef="C_reviewQ"/>
    <bpmn:sequenceFlow id="F_C_reviewQ_C_gw" sourceRef="C_reviewQ" targetRef="C_gw"/>
    <bpmn:sequenceFlow id="F_C_gw_C_sign" name="Yes" sourceRef="C_gw" targetRef="C_sign"/>
    <bpmn:sequenceFlow id="F_C_gw_C_refuse" name="No" sourceRef="C_gw" targetRef="C_refuse"/>
    <bpmn:sequenceFlow id="F_C_refuse_C_endCancel" sourceRef="C_refuse" targetRef="C_endCancel"/>
    <bpmn:sequenceFlow id="F_C_sign_C_goods" sourceRef="C_sign" targetRef="C_goods"/>
    <bpmn:sequenceFlow id="F_C_goods_C_inv" sourceRef="C_goods" targetRef="C_inv"/>
    <bpmn:sequenceFlow id="F_C_inv_C_pay" sourceRef="C_inv" targetRef="C_pay"/>
    <bpmn:sequenceFlow id="F_C_pay_C_end" sourceRef="C_pay" targetRef="C_end"/>
  </bpmn:process>
  <bpmn:process id="Proc_Company" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Company">
      <bpmn:lane id="L_Sales" name="Salesman">
        <bpmn:flowNodeRef>S_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_createQ</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_sendQ</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_evgw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_refuse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_endCancel</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Store" name="Store manager">
        <bpmn:flowNodeRef>W_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W_avail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W_notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W_replen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W_method</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W_ship</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W_pickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W_validate</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Acc" name="Accountant">
        <bpmn:flowNodeRef>A_create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_post</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_remind</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_endRem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_reconcile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_due</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Mgr" name="Sales manager">
        <bpmn:flowNodeRef>M_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_lock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S_start" name="Request for quotation received"><bpmn:outgoing>F_S_start_S_createQ</bpmn:outgoing><bpmn:messageEventDefinition id="MED_S_start"/></bpmn:startEvent>
    <bpmn:userTask id="S_createQ" name="Create quotation"><bpmn:incoming>F_S_start_S_createQ</bpmn:incoming><bpmn:outgoing>F_S_createQ_S_sendQ</bpmn:outgoing></bpmn:userTask>
    <bpmn:sendTask id="S_sendQ" name="Send quotation by email"><bpmn:incoming>F_S_createQ_S_sendQ</bpmn:incoming><bpmn:outgoing>F_S_sendQ_S_evgw</bpmn:outgoing></bpmn:sendTask>
    <bpmn:eventBasedGateway id="S_evgw" name=""><bpmn:incoming>F_S_sendQ_S_evgw</bpmn:incoming><bpmn:outgoing>F_S_evgw_S_accept</bpmn:outgoing><bpmn:outgoing>F_S_evgw_S_refuse</bpmn:outgoing><bpmn:outgoing>F_S_evgw_S_timer</bpmn:outgoing></bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="S_accept" name="Quotation accepted"><bpmn:incoming>F_S_evgw_S_accept</bpmn:incoming><bpmn:outgoing>F_S_accept_S_confirm</bpmn:outgoing><bpmn:messageEventDefinition id="MED_S_accept"/></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="S_refuse" name="Quotation refused"><bpmn:incoming>F_S_evgw_S_refuse</bpmn:incoming><bpmn:outgoing>F_S_refuse_S_merge</bpmn:outgoing><bpmn:messageEventDefinition id="MED_S_refuse"/></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="S_timer" name="Expiration date reached"><bpmn:incoming>F_S_evgw_S_timer</bpmn:incoming><bpmn:outgoing>F_S_timer_S_merge</bpmn:outgoing><bpmn:timerEventDefinition id="TED_S_timer"/></bpmn:intermediateCatchEvent>
    <bpmn:userTask id="S_confirm" name="Confirm quotation (Sales Order)"><bpmn:incoming>F_S_accept_S_confirm</bpmn:incoming><bpmn:outgoing>F_S_confirm_W_check</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="S_merge" name=""><bpmn:incoming>F_S_refuse_S_merge</bpmn:incoming><bpmn:incoming>F_S_timer_S_merge</bpmn:incoming><bpmn:outgoing>F_S_merge_S_cancel</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="S_cancel" name="Cancel quotation"><bpmn:incoming>F_S_merge_S_cancel</bpmn:incoming><bpmn:outgoing>F_S_cancel_S_endCancel</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="S_endCancel" name="Quotation cancelled"><bpmn:incoming>F_S_cancel_S_endCancel</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="W_check" name="Check availability &amp; reserve stock"><bpmn:incoming>F_S_confirm_W_check</bpmn:incoming><bpmn:incoming>F_W_replen_W_check</bpmn:incoming><bpmn:outgoing>F_W_check_W_avail</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="W_avail" name="Products available?"><bpmn:incoming>F_W_check_W_avail</bpmn:incoming><bpmn:outgoing>F_W_avail_W_method</bpmn:outgoing><bpmn:outgoing>F_W_avail_W_notify</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="W_notify" name="Notify customer of delay"><bpmn:incoming>F_W_avail_W_notify</bpmn:incoming><bpmn:outgoing>F_W_notify_W_replen</bpmn:outgoing></bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="W_replen" name="Stock replenished"><bpmn:incoming>F_W_notify_W_replen</bpmn:incoming><bpmn:outgoing>F_W_replen_W_check</bpmn:outgoing><bpmn:conditionalEventDefinition id="CED_W_replen"><bpmn:condition xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">qty_available &gt;= ordered qty</bpmn:condition></bpmn:conditionalEventDefinition></bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="W_method" name="Delivery method?"><bpmn:incoming>F_W_avail_W_method</bpmn:incoming><bpmn:outgoing>F_W_method_W_ship</bpmn:outgoing><bpmn:outgoing>F_W_method_W_pickup</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="W_ship" name="Pack &amp; ship via carrier"><bpmn:incoming>F_W_method_W_ship</bpmn:incoming><bpmn:outgoing>F_W_ship_W_join</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="W_pickup" name="Prepare goods for store pickup"><bpmn:incoming>F_W_method_W_pickup</bpmn:incoming><bpmn:outgoing>F_W_pickup_W_join</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="W_join" name=""><bpmn:incoming>F_W_ship_W_join</bpmn:incoming><bpmn:incoming>F_W_pickup_W_join</bpmn:incoming><bpmn:outgoing>F_W_join_W_validate</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="W_validate" name="Validate delivery (stock updated)"><bpmn:incoming>F_W_join_W_validate</bpmn:incoming><bpmn:outgoing>F_W_validate_A_create</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="A_create" name="Create invoice"><bpmn:incoming>F_W_validate_A_create</bpmn:incoming><bpmn:outgoing>F_A_create_A_post</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="A_post" name="Confirm (post) invoice"><bpmn:incoming>F_A_create_A_post</bpmn:incoming><bpmn:outgoing>F_A_post_A_send</bpmn:outgoing></bpmn:userTask>
    <bpmn:sendTask id="A_send" name="Send invoice"><bpmn:incoming>F_A_post_A_send</bpmn:incoming><bpmn:outgoing>F_A_send_A_wait</bpmn:outgoing></bpmn:sendTask>
    <bpmn:receiveTask id="A_wait" name="Receive payment"><bpmn:incoming>F_A_send_A_wait</bpmn:incoming><bpmn:outgoing>F_A_wait_A_register</bpmn:outgoing></bpmn:receiveTask>
    <bpmn:sendTask id="A_remind" name="Send payment reminder"><bpmn:incoming>F_A_due_A_remind</bpmn:incoming><bpmn:outgoing>F_A_remind_A_endRem</bpmn:outgoing></bpmn:sendTask>
    <bpmn:endEvent id="A_endRem" name="Reminder sent"><bpmn:incoming>F_A_remind_A_endRem</bpmn:incoming></bpmn:endEvent>
    <bpmn:userTask id="A_register" name="Register payment"><bpmn:incoming>F_A_wait_A_register</bpmn:incoming><bpmn:outgoing>F_A_register_A_reconcile</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="A_reconcile" name="Reconcile payment with invoice"><bpmn:incoming>F_A_register_A_reconcile</bpmn:incoming><bpmn:outgoing>F_A_reconcile_M_review</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="M_review" name="Review customer account"><bpmn:incoming>F_A_reconcile_M_review</bpmn:incoming><bpmn:outgoing>F_M_review_M_lock</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="M_lock" name="Lock &amp; close sales order"><bpmn:incoming>F_M_review_M_lock</bpmn:incoming><bpmn:outgoing>F_M_lock_M_end</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="M_end" name="Sale completed"><bpmn:incoming>F_M_lock_M_end</bpmn:incoming></bpmn:endEvent>
    <bpmn:boundaryEvent id="A_due" name="Due date passed" attachedToRef="A_wait" cancelActivity="false"><bpmn:outgoing>F_A_due_A_remind</bpmn:outgoing><bpmn:timerEventDefinition id="TED_A_due"/></bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="F_S_start_S_createQ" sourceRef="S_start" targetRef="S_createQ"/>
    <bpmn:sequenceFlow id="F_S_createQ_S_sendQ" sourceRef="S_createQ" targetRef="S_sendQ"/>
    <bpmn:sequenceFlow id="F_S_sendQ_S_evgw" sourceRef="S_sendQ" targetRef="S_evgw"/>
    <bpmn:sequenceFlow id="F_S_evgw_S_accept" sourceRef="S_evgw" targetRef="S_accept"/>
    <bpmn:sequenceFlow id="F_S_evgw_S_refuse" sourceRef="S_evgw" targetRef="S_refuse"/>
    <bpmn:sequenceFlow id="F_S_evgw_S_timer" sourceRef="S_evgw" targetRef="S_timer"/>
    <bpmn:sequenceFlow id="F_S_accept_S_confirm" sourceRef="S_accept" targetRef="S_confirm"/>
    <bpmn:sequenceFlow id="F_S_refuse_S_merge" sourceRef="S_refuse" targetRef="S_merge"/>
    <bpmn:sequenceFlow id="F_S_timer_S_merge" sourceRef="S_timer" targetRef="S_merge"/>
    <bpmn:sequenceFlow id="F_S_merge_S_cancel" sourceRef="S_merge" targetRef="S_cancel"/>
    <bpmn:sequenceFlow id="F_S_cancel_S_endCancel" sourceRef="S_cancel" targetRef="S_endCancel"/>
    <bpmn:sequenceFlow id="F_S_confirm_W_check" sourceRef="S_confirm" targetRef="W_check"/>
    <bpmn:sequenceFlow id="F_W_check_W_avail" sourceRef="W_check" targetRef="W_avail"/>
    <bpmn:sequenceFlow id="F_W_avail_W_method" name="Yes" sourceRef="W_avail" targetRef="W_method"/>
    <bpmn:sequenceFlow id="F_W_avail_W_notify" name="No" sourceRef="W_avail" targetRef="W_notify"/>
    <bpmn:sequenceFlow id="F_W_notify_W_replen" sourceRef="W_notify" targetRef="W_replen"/>
    <bpmn:sequenceFlow id="F_W_replen_W_check" sourceRef="W_replen" targetRef="W_check"/>
    <bpmn:sequenceFlow id="F_W_method_W_ship" name="Ship" sourceRef="W_method" targetRef="W_ship"/>
    <bpmn:sequenceFlow id="F_W_method_W_pickup" name="Pickup" sourceRef="W_method" targetRef="W_pickup"/>
    <bpmn:sequenceFlow id="F_W_ship_W_join" sourceRef="W_ship" targetRef="W_join"/>
    <bpmn:sequenceFlow id="F_W_pickup_W_join" sourceRef="W_pickup" targetRef="W_join"/>
    <bpmn:sequenceFlow id="F_W_join_W_validate" sourceRef="W_join" targetRef="W_validate"/>
    <bpmn:sequenceFlow id="F_W_validate_A_create" sourceRef="W_validate" targetRef="A_create"/>
    <bpmn:sequenceFlow id="F_A_create_A_post" sourceRef="A_create" targetRef="A_post"/>
    <bpmn:sequenceFlow id="F_A_post_A_send" sourceRef="A_post" targetRef="A_send"/>
    <bpmn:sequenceFlow id="F_A_send_A_wait" sourceRef="A_send" targetRef="A_wait"/>
    <bpmn:sequenceFlow id="F_A_wait_A_register" sourceRef="A_wait" targetRef="A_register"/>
    <bpmn:sequenceFlow id="F_A_due_A_remind" sourceRef="A_due" targetRef="A_remind"/>
    <bpmn:sequenceFlow id="F_A_remind_A_endRem" sourceRef="A_remind" targetRef="A_endRem"/>
    <bpmn:sequenceFlow id="F_A_register_A_reconcile" sourceRef="A_register" targetRef="A_reconcile"/>
    <bpmn:sequenceFlow id="F_A_reconcile_M_review" sourceRef="A_reconcile" targetRef="M_review"/>
    <bpmn:sequenceFlow id="F_M_review_M_lock" sourceRef="M_review" targetRef="M_lock"/>
    <bpmn:sequenceFlow id="F_M_lock_M_end" sourceRef="M_lock" targetRef="M_end"/>
    <bpmn:textAnnotation id="TA1"><bpmn:text>Odoo sale.order: Quotation → Quotation Sent</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_TA1" sourceRef="S_sendQ" targetRef="TA1"/>
    <bpmn:textAnnotation id="TA2"><bpmn:text>action_confirm(): Quotation → Sales Order; delivery order WH/OUT created</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_TA2" sourceRef="S_confirm" targetRef="TA2"/>
    <bpmn:textAnnotation id="TA3"><bpmn:text>stock.picking: Draft → Waiting → Ready → Done</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_TA3" sourceRef="W_validate" targetRef="TA3"/>
    <bpmn:textAnnotation id="TA4"><bpmn:text>account.move: Draft → Posted</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_TA4" sourceRef="A_post" targetRef="TA4"/>
    <bpmn:textAnnotation id="TA5"><bpmn:text>payment_state: Not paid → In payment → Paid</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_TA5" sourceRef="A_reconcile" targetRef="TA5"/>
    <bpmn:textAnnotation id="TA6"><bpmn:text>sale.order fully delivered &amp; invoiced → locked (Done)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_TA6" sourceRef="M_end" targetRef="TA6"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram"><bpmndi:BPMNPlane id="Plane" bpmnElement="Collab">
    <bpmndi:BPMNShape id="P_Customer_di" bpmnElement="P_Customer" isHorizontal="true"><dc:Bounds x="40" y="40" width="3360" height="250"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P_Company_di" bpmnElement="P_Company" isHorizontal="true"><dc:Bounds x="40" y="340" width="3360" height="990"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="L_Sales_di" bpmnElement="L_Sales" isHorizontal="true"><dc:Bounds x="70" y="340" width="3330" height="320"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="L_Store_di" bpmnElement="L_Store" isHorizontal="true"><dc:Bounds x="70" y="660" width="3330" height="320"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="L_Acc_di" bpmnElement="L_Acc" isHorizontal="true"><dc:Bounds x="70" y="980" width="3330" height="220"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="L_Mgr_di" bpmnElement="L_Mgr" isHorizontal="true"><dc:Bounds x="70" y="1200" width="3330" height="130"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="C_start_di" bpmnElement="C_start"><dc:Bounds x="82" y="82" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="C_sendReq_di" bpmnElement="C_sendReq"><dc:Bounds x="145" y="65" width="110" height="70"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="C_reviewQ_di" bpmnElement="C_reviewQ"><dc:Bounds x="395" y="65" width="110" height="70"/></bpmndi:BPMNShape>
