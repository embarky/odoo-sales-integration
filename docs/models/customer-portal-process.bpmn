<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Saturne" targetNamespace="http://heclausanne-saturne/bpmn">
  <bpmn:collaboration id="Collab">
    <bpmn:participant id="P_Customer" name="Customer (web portal)" processRef="Proc_Customer"/>
    <bpmn:participant id="P_Company" name="Saturne (Odoo ERP + customer portal)" processRef="Proc_Company"/>
    <bpmn:messageFlow id="M_P_show_C_review" name="Quotation" sourceRef="P_show" targetRef="C_review"/>
    <bpmn:messageFlow id="M_C_edit_P_chg" name="New quantities" sourceRef="C_edit" targetRef="P_chg"/>
    <bpmn:messageFlow id="M_C_accept_P_acc" name="Acceptance" sourceRef="C_accept" targetRef="P_acc"/>
    <bpmn:messageFlow id="M_C_decline_P_dec" name="Refusal" sourceRef="C_decline" targetRef="P_dec"/>
    <bpmn:messageFlow id="M_C_accDate_P_dAcc" name="Date accepted" sourceRef="C_accDate" targetRef="P_dAcc"/>
    <bpmn:messageFlow id="M_C_reqDate_P_dReq" name="Requested date" sourceRef="C_reqDate" targetRef="P_dReq"/>
    <bpmn:messageFlow id="M_P_publish_C_decision" name="Decision" sourceRef="P_publish" targetRef="C_decision"/>
    <bpmn:messageFlow id="M_W_validate_C_goods" name="Goods" sourceRef="W_validate" targetRef="C_goods"/>
    <bpmn:messageFlow id="M_C_incident_D_start2" name="Problem report" sourceRef="C_incident" targetRef="D_start2"/>
    <bpmn:messageFlow id="M_A_invoice_C_invoice" name="Invoice" sourceRef="A_invoice" targetRef="C_invoice"/>
    <bpmn:messageFlow id="M_C_pay_A_pay" name="Payment" sourceRef="C_pay" targetRef="A_pay"/>
  </bpmn:collaboration>
  <bpmn:process id="Proc_Customer" isExecutable="false">
    <bpmn:startEvent id="C_start" name="Quotation available in portal"><bpmn:outgoing>F_C_start_C_review</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="C_review" name="Review quotation"><bpmn:incoming>F_C_start_C_review</bpmn:incoming><bpmn:incoming>F_C_edit_C_review</bpmn:incoming><bpmn:outgoing>F_C_review_C_gwChange</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="C_gwChange" name="Change needed?"><bpmn:incoming>F_C_review_C_gwChange</bpmn:incoming><bpmn:outgoing>F_C_gwChange_C_gwAccept</bpmn:outgoing><bpmn:outgoing>F_C_gwChange_C_edit</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="C_edit" name="Change quantity / remove product"><bpmn:incoming>F_C_gwChange_C_edit</bpmn:incoming><bpmn:outgoing>F_C_edit_C_review</bpmn:outgoing></bpmn:sendTask>
    <bpmn:exclusiveGateway id="C_gwAccept" name="Accept quotation?"><bpmn:incoming>F_C_gwChange_C_gwAccept</bpmn:incoming><bpmn:outgoing>F_C_gwAccept_C_accept</bpmn:outgoing><bpmn:outgoing>F_C_gwAccept_C_decline</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="C_accept" name="Accept and confirm"><bpmn:incoming>F_C_gwAccept_C_accept</bpmn:incoming><bpmn:outgoing>F_C_accept_C_check</bpmn:outgoing></bpmn:sendTask>
    <bpmn:sendTask id="C_decline" name="Decline quotation"><bpmn:incoming>F_C_gwAccept_C_decline</bpmn:incoming><bpmn:outgoing>F_C_decline_C_endDecl</bpmn:outgoing></bpmn:sendTask>
    <bpmn:endEvent id="C_endDecl" name="Quotation declined"><bpmn:incoming>F_C_decline_C_endDecl</bpmn:incoming></bpmn:endEvent>
    <bpmn:userTask id="C_check" name="Check planned delivery date"><bpmn:incoming>F_C_accept_C_check</bpmn:incoming><bpmn:outgoing>F_C_check_C_gwDate</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="C_gwDate" name="Date suitable?"><bpmn:incoming>F_C_check_C_gwDate</bpmn:incoming><bpmn:outgoing>F_C_gwDate_C_accDate</bpmn:outgoing><bpmn:outgoing>F_C_gwDate_C_reqDate</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="C_accDate" name="Accept delivery date"><bpmn:incoming>F_C_gwDate_C_accDate</bpmn:incoming><bpmn:outgoing>F_C_accDate_C_join</bpmn:outgoing></bpmn:sendTask>
    <bpmn:sendTask id="C_reqDate" name="Request another date"><bpmn:incoming>F_C_gwDate_C_reqDate</bpmn:incoming><bpmn:outgoing>F_C_reqDate_C_decision</bpmn:outgoing></bpmn:sendTask>
    <bpmn:receiveTask id="C_decision" name="See decision in portal"><bpmn:incoming>F_C_reqDate_C_decision</bpmn:incoming><bpmn:outgoing>F_C_decision_C_join</bpmn:outgoing></bpmn:receiveTask>
    <bpmn:exclusiveGateway id="C_join" name=""><bpmn:incoming>F_C_accDate_C_join</bpmn:incoming><bpmn:incoming>F_C_decision_C_join</bpmn:incoming><bpmn:outgoing>F_C_join_C_goods</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:receiveTask id="C_goods" name="Receive goods"><bpmn:incoming>F_C_join_C_goods</bpmn:incoming><bpmn:outgoing>F_C_goods_C_gwIssue</bpmn:outgoing></bpmn:receiveTask>
    <bpmn:exclusiveGateway id="C_gwIssue" name="Problem with the delivery?"><bpmn:incoming>F_C_goods_C_gwIssue</bpmn:incoming><bpmn:outgoing>F_C_gwIssue_C_join2</bpmn:outgoing><bpmn:outgoing>F_C_gwIssue_C_incident</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="C_incident" name="Report a problem"><bpmn:incoming>F_C_gwIssue_C_incident</bpmn:incoming><bpmn:outgoing>F_C_incident_C_join2</bpmn:outgoing></bpmn:sendTask>
    <bpmn:exclusiveGateway id="C_join2" name=""><bpmn:incoming>F_C_gwIssue_C_join2</bpmn:incoming><bpmn:incoming>F_C_incident_C_join2</bpmn:incoming><bpmn:outgoing>F_C_join2_C_invoice</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:receiveTask id="C_invoice" name="Download invoice (PDF)"><bpmn:incoming>F_C_join2_C_invoice</bpmn:incoming><bpmn:outgoing>F_C_invoice_C_pay</bpmn:outgoing></bpmn:receiveTask>
    <bpmn:sendTask id="C_pay" name="Pay invoice"><bpmn:incoming>F_C_invoice_C_pay</bpmn:incoming><bpmn:outgoing>F_C_pay_C_end</bpmn:outgoing></bpmn:sendTask>
    <bpmn:endEvent id="C_end" name="Order completed"><bpmn:incoming>F_C_pay_C_end</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F_C_start_C_review" sourceRef="C_start" targetRef="C_review"/>
    <bpmn:sequenceFlow id="F_C_review_C_gwChange" sourceRef="C_review" targetRef="C_gwChange"/>
    <bpmn:sequenceFlow id="F_C_gwChange_C_gwAccept" name="No" sourceRef="C_gwChange" targetRef="C_gwAccept"/>
    <bpmn:sequenceFlow id="F_C_gwChange_C_edit" name="Yes" sourceRef="C_gwChange" targetRef="C_edit"/>
    <bpmn:sequenceFlow id="F_C_edit_C_review" sourceRef="C_edit" targetRef="C_review"/>
    <bpmn:sequenceFlow id="F_C_gwAccept_C_accept" name="Yes" sourceRef="C_gwAccept" targetRef="C_accept"/>
    <bpmn:sequenceFlow id="F_C_gwAccept_C_decline" name="No" sourceRef="C_gwAccept" targetRef="C_decline"/>
    <bpmn:sequenceFlow id="F_C_decline_C_endDecl" sourceRef="C_decline" targetRef="C_endDecl"/>
    <bpmn:sequenceFlow id="F_C_accept_C_check" sourceRef="C_accept" targetRef="C_check"/>
    <bpmn:sequenceFlow id="F_C_check_C_gwDate" sourceRef="C_check" targetRef="C_gwDate"/>
    <bpmn:sequenceFlow id="F_C_gwDate_C_accDate" name="Yes" sourceRef="C_gwDate" targetRef="C_accDate"/>
    <bpmn:sequenceFlow id="F_C_gwDate_C_reqDate" name="No" sourceRef="C_gwDate" targetRef="C_reqDate"/>
    <bpmn:sequenceFlow id="F_C_accDate_C_join" sourceRef="C_accDate" targetRef="C_join"/>
    <bpmn:sequenceFlow id="F_C_reqDate_C_decision" sourceRef="C_reqDate" targetRef="C_decision"/>
    <bpmn:sequenceFlow id="F_C_decision_C_join" sourceRef="C_decision" targetRef="C_join"/>
    <bpmn:sequenceFlow id="F_C_join_C_goods" sourceRef="C_join" targetRef="C_goods"/>
    <bpmn:sequenceFlow id="F_C_goods_C_gwIssue" sourceRef="C_goods" targetRef="C_gwIssue"/>
    <bpmn:sequenceFlow id="F_C_gwIssue_C_join2" name="No" sourceRef="C_gwIssue" targetRef="C_join2"/>
    <bpmn:sequenceFlow id="F_C_gwIssue_C_incident" name="Yes" sourceRef="C_gwIssue" targetRef="C_incident"/>
    <bpmn:sequenceFlow id="F_C_incident_C_join2" sourceRef="C_incident" targetRef="C_join2"/>
    <bpmn:sequenceFlow id="F_C_join2_C_invoice" sourceRef="C_join2" targetRef="C_invoice"/>
    <bpmn:sequenceFlow id="F_C_invoice_C_pay" sourceRef="C_invoice" targetRef="C_pay"/>
    <bpmn:sequenceFlow id="F_C_pay_C_end" sourceRef="C_pay" targetRef="C_end"/>
  </bpmn:process>
  <bpmn:process id="Proc_Company" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Company">
      <bpmn:lane id="L_Portal" name="Portal (Node-RED + API)">
        <bpmn:flowNodeRef>P_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_show</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_evgw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_acc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_chg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_endCancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_evgw2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_dAcc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_dReq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_note</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_store</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_write</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_publish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Desk" name="Service desk (sales manager)">
        <bpmn:flowNodeRef>D_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D_start2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D_reply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D_end2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Store" name="Warehouse">
        <bpmn:flowNodeRef>W_validate</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Acc" name="Accountant">
        <bpmn:flowNodeRef>A_invoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P_start" name="Quotation created in Odoo"><bpmn:outgoing>F_P_start_P_show</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="P_show" name="Show orders (API reads Odoo)"><bpmn:incoming>F_P_start_P_show</bpmn:incoming><bpmn:incoming>F_P_update_P_show</bpmn:incoming><bpmn:outgoing>F_P_show_P_evgw</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:eventBasedGateway id="P_evgw" name=""><bpmn:incoming>F_P_show_P_evgw</bpmn:incoming><bpmn:outgoing>F_P_evgw_P_acc</bpmn:outgoing><bpmn:outgoing>F_P_evgw_P_dec</bpmn:outgoing><bpmn:outgoing>F_P_evgw_P_chg</bpmn:outgoing></bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="P_acc" name="Quotation accepted"><bpmn:incoming>F_P_evgw_P_acc</bpmn:incoming><bpmn:outgoing>F_P_acc_P_confirm</bpmn:outgoing><bpmn:messageEventDefinition id="MED_P_acc"/></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="P_dec" name="Quotation declined"><bpmn:incoming>F_P_evgw_P_dec</bpmn:incoming><bpmn:outgoing>F_P_dec_P_cancel</bpmn:outgoing><bpmn:messageEventDefinition id="MED_P_dec"/></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="P_chg" name="Change received"><bpmn:incoming>F_P_evgw_P_chg</bpmn:incoming><bpmn:outgoing>F_P_chg_P_update</bpmn:outgoing><bpmn:messageEventDefinition id="MED_P_chg"/></bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="P_update" name="Update quotation lines in Odoo"><bpmn:incoming>F_P_chg_P_update</bpmn:incoming><bpmn:outgoing>F_P_update_P_show</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P_cancel" name="Cancel quotation in Odoo"><bpmn:incoming>F_P_dec_P_cancel</bpmn:incoming><bpmn:outgoing>F_P_cancel_P_endCancel</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="P_endCancel" name="Quotation cancelled"><bpmn:incoming>F_P_cancel_P_endCancel</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="P_confirm" name="Confirm order in Odoo"><bpmn:incoming>F_P_acc_P_confirm</bpmn:incoming><bpmn:outgoing>F_P_confirm_P_evgw2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:eventBasedGateway id="P_evgw2" name=""><bpmn:incoming>F_P_confirm_P_evgw2</bpmn:incoming><bpmn:outgoing>F_P_evgw2_P_dAcc</bpmn:outgoing><bpmn:outgoing>F_P_evgw2_P_dReq</bpmn:outgoing></bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="P_dAcc" name="Date accepted"><bpmn:incoming>F_P_evgw2_P_dAcc</bpmn:incoming><bpmn:outgoing>F_P_dAcc_P_note</bpmn:outgoing><bpmn:messageEventDefinition id="MED_P_dAcc"/></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="P_dReq" name="Date change requested"><bpmn:incoming>F_P_evgw2_P_dReq</bpmn:incoming><bpmn:outgoing>F_P_dReq_P_store</bpmn:outgoing><bpmn:messageEventDefinition id="MED_P_dReq"/></bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="P_note" name="Log acceptance on the order"><bpmn:incoming>F_P_dAcc_P_note</bpmn:incoming><bpmn:outgoing>F_P_note_P_join</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P_store" name="Store the request"><bpmn:incoming>F_P_dReq_P_store</bpmn:incoming><bpmn:outgoing>F_P_store_D_review</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P_write" name="Write new date to Odoo"><bpmn:incoming>F_D_gw_P_write</bpmn:incoming><bpmn:outgoing>F_P_write_P_publish</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P_publish" name="Publish decision in portal"><bpmn:incoming>F_P_write_P_publish</bpmn:incoming><bpmn:incoming>F_D_reject_P_publish</bpmn:incoming><bpmn:outgoing>F_P_publish_P_join</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P_join" name=""><bpmn:incoming>F_P_note_P_join</bpmn:incoming><bpmn:incoming>F_P_publish_P_join</bpmn:incoming><bpmn:outgoing>F_P_join_W_validate</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="D_review" name="Review date request"><bpmn:incoming>F_P_store_D_review</bpmn:incoming><bpmn:outgoing>F_D_review_D_gw</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="D_gw" name="Approve?"><bpmn:incoming>F_D_review_D_gw</bpmn:incoming><bpmn:outgoing>F_D_gw_P_write</bpmn:outgoing><bpmn:outgoing>F_D_gw_D_reject</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="D_reject" name="Reject with a note"><bpmn:incoming>F_D_gw_D_reject</bpmn:incoming><bpmn:outgoing>F_D_reject_P_publish</bpmn:outgoing></bpmn:userTask>
    <bpmn:startEvent id="D_start2" name="Problem or message received"><bpmn:outgoing>F_D_start2_D_reply</bpmn:outgoing><bpmn:messageEventDefinition id="MED_D_start2"/></bpmn:startEvent>
    <bpmn:userTask id="D_reply" name="Answer in the service desk"><bpmn:incoming>F_D_start2_D_reply</bpmn:incoming><bpmn:outgoing>F_D_reply_D_end2</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="D_end2" name="Customer answered"><bpmn:incoming>F_D_reply_D_end2</bpmn:incoming></bpmn:endEvent>
    <bpmn:userTask id="W_validate" name="Validate delivery"><bpmn:incoming>F_P_join_W_validate</bpmn:incoming><bpmn:outgoing>F_W_validate_A_invoice</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="A_invoice" name="Create and post invoice"><bpmn:incoming>F_W_validate_A_invoice</bpmn:incoming><bpmn:outgoing>F_A_invoice_A_pay</bpmn:outgoing></bpmn:userTask>
    <bpmn:receiveTask id="A_pay" name="Register payment"><bpmn:incoming>F_A_invoice_A_pay</bpmn:incoming><bpmn:outgoing>F_A_pay_A_end</bpmn:outgoing></bpmn:receiveTask>
    <bpmn:endEvent id="A_end" name="Sale completed"><bpmn:incoming>F_A_pay_A_end</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F_P_start_P_show" sourceRef="P_start" targetRef="P_show"/>
    <bpmn:sequenceFlow id="F_P_show_P_evgw" sourceRef="P_show" targetRef="P_evgw"/>
    <bpmn:sequenceFlow id="F_P_evgw_P_acc" sourceRef="P_evgw" targetRef="P_acc"/>
    <bpmn:sequenceFlow id="F_P_evgw_P_dec" sourceRef="P_evgw" targetRef="P_dec"/>
    <bpmn:sequenceFlow id="F_P_evgw_P_chg" sourceRef="P_evgw" targetRef="P_chg"/>
    <bpmn:sequenceFlow id="F_P_chg_P_update" sourceRef="P_chg" targetRef="P_update"/>
    <bpmn:sequenceFlow id="F_P_update_P_show" sourceRef="P_update" targetRef="P_show"/>
    <bpmn:sequenceFlow id="F_P_acc_P_confirm" sourceRef="P_acc" targetRef="P_confirm"/>
    <bpmn:sequenceFlow id="F_P_dec_P_cancel" sourceRef="P_dec" targetRef="P_cancel"/>
    <bpmn:sequenceFlow id="F_P_cancel_P_endCancel" sourceRef="P_cancel" targetRef="P_endCancel"/>
    <bpmn:sequenceFlow id="F_P_confirm_P_evgw2" sourceRef="P_confirm" targetRef="P_evgw2"/>
    <bpmn:sequenceFlow id="F_P_evgw2_P_dAcc" sourceRef="P_evgw2" targetRef="P_dAcc"/>
    <bpmn:sequenceFlow id="F_P_evgw2_P_dReq" sourceRef="P_evgw2" targetRef="P_dReq"/>
    <bpmn:sequenceFlow id="F_P_dAcc_P_note" sourceRef="P_dAcc" targetRef="P_note"/>
    <bpmn:sequenceFlow id="F_P_note_P_join" sourceRef="P_note" targetRef="P_join"/>
    <bpmn:sequenceFlow id="F_P_dReq_P_store" sourceRef="P_dReq" targetRef="P_store"/>
    <bpmn:sequenceFlow id="F_P_store_D_review" sourceRef="P_store" targetRef="D_review"/>
    <bpmn:sequenceFlow id="F_D_review_D_gw" sourceRef="D_review" targetRef="D_gw"/>
    <bpmn:sequenceFlow id="F_D_gw_P_write" name="Yes" sourceRef="D_gw" targetRef="P_write"/>
    <bpmn:sequenceFlow id="F_D_gw_D_reject" name="No" sourceRef="D_gw" targetRef="D_reject"/>
    <bpmn:sequenceFlow id="F_P_write_P_publish" sourceRef="P_write" targetRef="P_publish"/>
    <bpmn:sequenceFlow id="F_D_reject_P_publish" sourceRef="D_reject" targetRef="P_publish"/>
    <bpmn:sequenceFlow id="F_P_publish_P_join" sourceRef="P_publish" targetRef="P_join"/>
    <bpmn:sequenceFlow id="F_P_join_W_validate" sourceRef="P_join" targetRef="W_validate"/>
    <bpmn:sequenceFlow id="F_W_validate_A_invoice" sourceRef="W_validate" targetRef="A_invoice"/>
    <bpmn:sequenceFlow id="F_A_invoice_A_pay" sourceRef="A_invoice" targetRef="A_pay"/>
    <bpmn:sequenceFlow id="F_A_pay_A_end" sourceRef="A_pay" targetRef="A_end"/>
    <bpmn:sequenceFlow id="F_D_start2_D_reply" sourceRef="D_start2" targetRef="D_reply"/>
    <bpmn:sequenceFlow id="F_D_reply_D_end2" sourceRef="D_reply" targetRef="D_end2"/>
    <bpmn:textAnnotation id="TA1"><bpmn:text>PUT / DELETE /saleorders/{order}/lines/{id}</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_TA1" sourceRef="P_update" targetRef="TA1"/>
    <bpmn:textAnnotation id="TA3"><bpmn:text>MySQL delivery_change_requests (pending)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_TA3" sourceRef="P_store" targetRef="TA3"/>
    <bpmn:textAnnotation id="TA4"><bpmn:text>PUT /saleorders/delivery_date/confirm/…/{date} → commitment_date</bpmn:text></bpmn:textAnnotation>
